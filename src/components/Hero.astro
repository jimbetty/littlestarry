---
interface Item { title: string; text: string; url: string; kind: string; }
interface Props { index: Item[]; }
const { index } = Astro.props;

const phrases = [
  { text: '会动的小游戏', href: '/works/hollow-toll/', q: '游戏', imgs: [1, 2] },
  { text: 'AI 画出来的梦', href: '/works/sample-image-series/', q: '图像', imgs: [3, 4] },
  { text: '深夜写的笔记', href: '/blog/', q: '笔记', imgs: [5, 6] },
  { text: '顺手的小工具', href: '/works/sample-tool/', q: '工具', imgs: [7, 8] },
];

// scattered tile field: deterministic pseudo-random, center kept clear for the headline
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const tiles: { x: number; y: number; s: number; r: number; img: number; o: number; d: number }[] = [];
let tries = 0;
while (tiles.length < 26 && tries < 2000) {
  tries++;
  const x = 3 + rnd() * 94, y = 6 + rnd() * 88;
  const dx = (x - 50) / 34, dy = (y - 48) / 30;
  const dist = Math.hypot(dx, dy);
  if (dist < 1) continue;                                   // clear centre
  if (tiles.some((t) => Math.hypot((t.x - x) * 1.6, t.y - y) < 13)) continue; // spacing
  tiles.push({
    x, y,
    s: Math.round(64 + rnd() * 64),
    r: Math.round((rnd() * 2 - 1) * 12),
    img: (tiles.length % 8) + 1,
    o: Math.min(1, 0.35 + (dist - 1) * 1.1),                // fade near centre
    d: dist,
  });
}
---
<section class="hero" data-hero>
  <div class="hero-stage" aria-hidden="true">
    <div class="hero-field">
      {tiles.map((t) => (
        <span class="tile" style={`left:${t.x}%;top:${t.y}%;--s:${t.s}px;--r:${t.r}deg;--o:${t.o.toFixed(2)};--d:${t.d.toFixed(2)}`}>
          <img src={`/hero/t${t.img}.webp`} alt="" width="160" height="160" decoding="async" />
        </span>
      ))}
    </div>
  </div>

  <div class="hero-inner">
    <h1 class="hero-title">
      <span class="hero-line">在星河里，找到</span>
      <span class="rotator" data-rotator>
        {phrases.map((p, i) => (
          <a class="phrase" href={p.href} data-q={p.q} aria-hidden={i ? 'true' : undefined} tabindex={i ? -1 : undefined}>
            <span class="phrase-text">{p.text}</span>
            <span class="thumbs" aria-hidden="true">
              <span class="thumb" style="--r:-6deg"><img src={`/hero/t${p.imgs[0]}.webp`} alt="" width="160" height="160" /></span>
              <span class="thumb" style="--r:6deg"><img src={`/hero/t${p.imgs[1]}.webp`} alt="" width="160" height="160" /></span>
            </span>
          </a>
        ))}
      </span>
    </h1>

    <div class="hero-search" data-search>
      <label class="search-pill">
        <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.75" cy="10.75" r="7.5"/><path d="m16.5 16.5 4.5 4.5"/></svg>
        <span class="search-field">
          <input type="search" autocomplete="off" spellcheck="false" aria-label="搜索作品和文章" data-search-input />
          <span class="ph" aria-hidden="true" data-ph><span class="ph-fix">搜索</span><span class="ph-typed" data-ph-typed></span></span>
        </span>
        <a class="search-go" href="/works/" aria-label="打开" data-search-go>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </label>
      <ul class="search-results" data-search-results role="listbox"></ul>
      <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
    </div>

    <div class="hero-cta">
      <a class="pill pill-dark" href="/works/">看看作品</a>
      <a class="pill pill-ghost" href="/blog/">读博客</a>
    </div>
  </div>

  <a href="#next" class="hero-next" aria-label="向下" data-hero-next>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
  </a>
</section>
