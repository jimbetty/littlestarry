---
interface Item { title: string; text: string; url: string; kind: string; }
interface Props { index: Item[]; }
const { index } = Astro.props;

const phrases = [
  { text: '体素搭的山城', href: '/works/yunshan/', q: '山城', imgs: [17, 22] },
  { text: '能拆开的柴油机', href: '/works/diesel/', q: '柴油机', imgs: [19, 9] },
  { text: '会动的小游戏', href: '/works/hollow-toll/', q: '游戏', imgs: [21, 11] },
  { text: '骑车的鹈鹕', href: '/works/pelican/', q: '鹈鹕', imgs: [20, 15] },
  { text: '深夜写的笔记', href: '/blog/', q: '笔记', imgs: [5, 6] },
];

// tunnel: cards sit on the wall of a long tube we look straight down (like cosmos.so).
// th = angle around the tube, d = depth phase (0 = far end, 1 = at the camera); hero.ts flies them toward the viewer.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const aspects = [[1, 1], [4, 5], [5, 4], [3, 4], [1, 1], [4, 3]];
const DEPTHS = 9, PER = 8, GA = Math.PI * (3 - Math.sqrt(5));
const tiles: { th: number; d: number; w: number; h: number; rz: number; img: number; m: number }[] = [];
for (let di = 0; di < DEPTHS; di++) {
  for (let j = 0; j < PER; j++) {
    const n = tiles.length;
    const [aw, ah] = aspects[Math.floor(rnd() * aspects.length)];
    const k = (92 + rnd() * 20) / Math.sqrt(aw * ah);
    tiles.push({
      // sunflower spread: golden-angle steps around, even steps in depth, so no two cards bunch up
      th: (n * GA) % (Math.PI * 2),
      d: (n + 0.5) / (DEPTHS * PER),
      w: Math.round(aw * k), h: Math.round(ah * k),
      rz: Math.round((rnd() * 2 - 1) * 14),
      img: ((n * 7) % 23) + 1,
      m: n % 2,
    });
  }
}
---
<section class="hero" data-hero>
  <div class="hero-stage" aria-hidden="true">
    <div class="hero-field" data-field>
      {tiles.map((t) => (
        <span class="tile" data-th={t.th.toFixed(4)} data-d={t.d.toFixed(3)} data-rz={t.rz} data-m={t.m} style={`width:${t.w}px;height:${t.h}px;margin:${-t.h / 2}px 0 0 ${-t.w / 2}px`}>
          <img src={`/hero/t${t.img}.webp`} alt="" width="160" height="160" decoding="async" />
        </span>
      ))}
    </div>
  </div>

  <div class="hero-inner">
    <h1 class="hero-title">
      <span class="hero-line">在星河里，找到</span>
      <span class="rotator" data-rotator>
        {phrases.map((p, i) => (
          <a class="phrase" href={p.href} data-q={p.q} aria-hidden={i ? 'true' : undefined} tabindex={i ? -1 : undefined}>
            <span class="phrase-text">{p.text}</span>
            <span class="thumbs" aria-hidden="true">
              <span class="thumb" style="--r:-6deg"><img src={`/hero/t${p.imgs[0]}.webp`} alt="" width="160" height="160" /></span>
              <span class="thumb" style="--r:6deg"><img src={`/hero/t${p.imgs[1]}.webp`} alt="" width="160" height="160" /></span>
            </span>
          </a>
        ))}
      </span>
    </h1>

    <div class="hero-search" data-search>
      <div class="search-shell">
        <label class="search-pill">
          <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="10.75" cy="10.75" r="7.5"/><path d="m16.4 16.4 4.6 4.6"/></svg>
          <span class="search-field">
            <input type="search" autocomplete="off" spellcheck="false" enterkeyhint="go" aria-label="搜索作品和文章" data-search-input />
            <span class="ph" aria-hidden="true" data-ph></span>
          </span>
          <kbd class="search-kbd" aria-hidden="true">/</kbd>
        </label>
        <button class="search-dice" type="button" aria-label="随便看看" title="随便看看" data-search-random>
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </button>
      </div>
      <ul class="search-results" data-search-results role="listbox"></ul>
      <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
    </div>

    <div class="hero-cta">
      <a class="pill pill-dark pill-lg" href="/works/">看看我的作品</a>
    </div>
  </div>

  <a href="#next" class="hero-next" aria-label="向下" data-hero-next>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
  </a>
</section>
