---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const allPosts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
const works = allWorks.slice(0, 3);
const posts = allPosts.slice(0, 3);
const index = [
  ...allWorks.map((w) => ({ kind: '作品', title: w.data.title, url: `/works/${w.id}/`, text: [w.data.summary, ...w.data.tools].join(' ') })),
  ...allPosts.map((p) => ({ kind: '文章', title: p.data.title, url: `/blog/${p.id}/`, text: [p.data.description, ...p.data.tags].join(' ') })),
];
---
<Base>
  <Hero slot="hero" index={index} />

  <section class="section" id="next" style="margin-top:0">
    <div class="section-head" data-reveal>
      <h2>精选作品</h2>
      <a href="/works/" class="more">全部作品 <span>→</span></a>
    </div>
    <div class="grid">
      {works.map((w) => <WorkCard id={w.id} {...w.data} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head" data-reveal>
      <h2>最新文章</h2>
      <a href="/blog/" class="more">全部文章 <span>→</span></a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
