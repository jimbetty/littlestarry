---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags } = post.data;
const text = post.body ?? '';
const minutes = Math.max(1, Math.round(text.length / 500));
---
<Base title={title} description={description}>
  <article class="article" data-article>
    <p class="eyebrow" data-reveal><a href="/blog/" class="more"><span>←</span> 博客</a></p>
    <h1 transition:name={`post-title-${post.id}`}>{title}</h1>
    <div class="meta" data-reveal>
      <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
      <span>约 {minutes} 分钟</span>
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="prose" data-reveal>
      <Content />
    </div>
  </article>
</Base>
